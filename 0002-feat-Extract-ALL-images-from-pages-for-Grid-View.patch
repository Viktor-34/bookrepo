+/**
+ * Extract ALL images from HTML for Grid View support
+ * Returns array of image URLs found in the document
+ */
+function extractAllImages(
+  htmlContent: string,
+  url: string,
+  jobId: string,
+  maxImages: number = 10,
+): string[] {
+  logger.info(
+    `[Crawler][${jobId}] Will attempt to extract all images from page ...`,
+  );
+
+  const virtualConsole = new VirtualConsole();
+  virtualConsole.on("error", () => {
+    /* suppress errors */
+  });
+
+  const dom = new JSDOM(htmlContent, { url, virtualConsole });
+  const images: string[] = [];
+
+  try {
+    const document = dom.window.document;
+
+    // Get all img tags
+    const imgElements = document.querySelectorAll("img");
+
+    for (const img of imgElements) {
+      const src = img.src;
+
+      // Skip invalid URLs (data URIs, small tracking pixels, etc)
+      if (
+        !src ||
+        src.startsWith("data:") ||
+        src.includes("spacer.gif") ||
+        src.includes("pixel.gif") ||
+        src.includes("tracking")
+      ) {
+        continue;
+      }
+
+      // Skip very small images (likely icons or tracking pixels)
+      const width = img.width || parseInt(img.getAttribute("width") || "0");
+      const height = img.height || parseInt(img.getAttribute("height") || "0");
+      if ((width > 0 && width < 100) || (height > 0 && height < 100)) {
+        continue;
+      }
+
+      // Convert relative URLs to absolute
+      try {
+        const absoluteUrl = new URL(src, url).toString();
+        if (!images.includes(absoluteUrl)) {
+          images.push(absoluteUrl);
+        }
+      } catch {
+        // Skip invalid URLs
+        continue;
+      }
+
+      // Limit number of images
+      if (images.length >= maxImages) {
+        break;
+      }
+    }
+
+    logger.info(
+      `[Crawler][${jobId}] Found ${images.length} images in the page.`,
+    );
+  } finally {
+    dom.window.close();
+  }
+
+  return images;
+}
