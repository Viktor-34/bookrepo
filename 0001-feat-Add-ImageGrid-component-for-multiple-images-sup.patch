+/**
+ * Get all banner images for a bookmark (supports multiple images for Grid View)
+ * Returns an array of image URLs from:
+ * 1. All assets with type "bannerImage"
+ * 2. Fallback to imageAssetId if no banner images found
+ * 3. Fallback to external imageUrl if no local assets found
+ */
+export function getBookmarkLinkImages(
+  bookmark: ZBookmark & { content: ZBookmarkedLink },
+): string[] {
+  const images: string[] = [];
+
+  // Get all banner image assets
+  const bannerImages = bookmark.assets.filter(
+    (asset) => asset.assetType === "bannerImage",
+  );
+
+  if (bannerImages.length > 0) {
+    // Use banner images
+    return bannerImages.map((asset) => getAssetUrl(asset.id));
+  }
+
+  // Fallback: use imageAssetId or imageUrl (for backward compatibility)
+  if (bookmark.content.imageAssetId) {
+    images.push(getAssetUrl(bookmark.content.imageAssetId));
+  } else if (bookmark.content.imageUrl) {
+    images.push(bookmark.content.imageUrl);
+  }
+
+  return images;
+}
