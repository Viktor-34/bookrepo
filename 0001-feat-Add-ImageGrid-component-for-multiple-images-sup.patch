--- /dev/null
+++ b/apps/web/components/ui/ImageGrid.tsx
@@ -0,0 +1,186 @@
+"use client";
+
+import { useState } from "react";
+import Image from "next/image";
+import { cn } from "@/lib/utils";
+import {
+  Dialog,
+  DialogContent,
+  DialogTrigger,
+} from "@/components/ui/dialog";
+
+interface ImageGridProps {
+  images: string[];
+  className?: string;
+  alt?: string;
+}
+
+/**
+ * ImageGrid component for displaying 1-4+ images in optimized layouts
+ *
+ * Layouts:
+ * - 1 image: Full width
+ * - 2 images: Two columns
+ * - 3 images: Two on top, one on bottom (spanning full width)
+ * - 4+ images: 2x2 grid with "Show N more" button for additional images
+ */
+export function ImageGrid({ images, className, alt = "Image" }: ImageGridProps) {
+  const [showAll, setShowAll] = useState(false);
+
+  if (!images || images.length === 0) {
+    return null;
+  }
+
+  const count = images.length;
+  const displayImages = showAll ? images : images.slice(0, 4);
+  const remainingCount = count - 4;
+
+  // Single image: full width
+  if (count === 1) {
+    return (
+      <div className={cn("relative w-full", className)}>
+        <ImageWithLightbox
+          src={images[0]}
+          alt={alt}
+          className="h-56 w-full rounded-t-lg object-cover"
+        />
+      </div>
+    );
+  }
+
+  // Two images: side by side
+  if (count === 2) {
+    return (
+      <div className={cn("grid grid-cols-2 gap-1", className)}>
+        {images.map((img, idx) => (
+          <ImageWithLightbox
+            key={idx}
+            src={img}
+            alt={`${alt} ${idx + 1}`}
+            className="h-56 w-full rounded-t-lg object-cover first:rounded-tr-none last:rounded-tl-none"
+          />
+        ))}
+      </div>
+    );
+  }
+
+  // Three images: 2 on top, 1 on bottom
+  if (count === 3) {
+    return (
+      <div className={cn("flex flex-col gap-1", className)}>
+        <div className="grid grid-cols-2 gap-1">
+          <ImageWithLightbox
+            src={images[0]}
+            alt={`${alt} 1`}
+            className="h-28 w-full rounded-tl-lg object-cover"
+          />
+          <ImageWithLightbox
+            src={images[1]}
+            alt={`${alt} 2`}
+            className="h-28 w-full rounded-tr-lg object-cover"
+          />
+        </div>
+        <ImageWithLightbox
+          src={images[2]}
+          alt={`${alt} 3`}
+          className="h-28 w-full object-cover"
+        />
+      </div>
+    );
+  }
+
+  // Four or more images: 2x2 grid
+  return (
+    <div className={cn("relative", className)}>
+      <div className="grid grid-cols-2 gap-1">
+        {displayImages.slice(0, 4).map((img, idx) => {
+          const isLast = idx === 3 && remainingCount > 0;
+
+          return (
+            <div key={idx} className="relative">
+              <ImageWithLightbox
+                src={img}
+                alt={`${alt} ${idx + 1}`}
+                className={cn(
+                  "h-28 w-full object-cover",
+                  idx === 0 && "rounded-tl-lg",
+                  idx === 1 && "rounded-tr-lg",
+                )}
+              />
+              {isLast && !showAll && (
+                <button
+                  onClick={() => setShowAll(true)}
+                  className="absolute inset-0 flex items-center justify-center bg-black/60 text-white transition-colors hover:bg-black/70"
+                >
+                  <span className="text-2xl font-semibold">
+                    +{remainingCount}
+                  </span>
+                </button>
+              )}
+            </div>
+          );
+        })}
+      </div>
+
+      {showAll && remainingCount > 0 && (
+        <div className="mt-1 grid grid-cols-2 gap-1">
+          {images.slice(4).map((img, idx) => (
+            <ImageWithLightbox
+              key={idx + 4}
+              src={img}
+              alt={`${alt} ${idx + 5}`}
+              className="h-28 w-full object-cover"
+            />
+          ))}
+        </div>
+      )}
+    </div>
+  );
+}
+
+/**
+ * Image with lightbox functionality
+ */
+function ImageWithLightbox({
+  src,
+  alt,
+  className,
+}: {
+  src: string;
+  alt: string;
+  className?: string;
+}) {
+  const [isOpen, setIsOpen] = useState(false);
+
+  return (
+    <Dialog open={isOpen} onOpenChange={setIsOpen}>
+      <DialogTrigger asChild>
+        <button
+          className={cn("relative overflow-hidden", className)}
+          onClick={() => setIsOpen(true)}
+        >
+          <Image
+            src={src}
+            alt={alt}
+            fill
+            sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
+            className="transition-transform hover:scale-105"
+            unoptimized={!src.startsWith("/") && !src.startsWith("http://localhost")}
+          />
+        </button>
+      </DialogTrigger>
+      <DialogContent className="max-h-[90vh] max-w-[90vw] overflow-hidden p-0">
+        <div className="relative h-full w-full">
+          <Image
+            src={src}
+            alt={alt}
+            width={1200}
+            height={800}
+            className="h-auto w-full object-contain"
+            unoptimized={!src.startsWith("/") && !src.startsWith("http://localhost")}
+          />
+        </div>
+      </DialogContent>
+    </Dialog>
+  );
+}
